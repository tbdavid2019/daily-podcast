{
  "name": "daily-podcast",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:workflow && pnpm test:web-cache && pnpm test:webmcp && pnpm test:pwa && pnpm test:build-gate && node --test tests/social-post.test.mjs",
    "postinstall": "npm run -s cf-typegen",
    "dev:worker": "wrangler dev --cwd worker --persist-to ../.wrangler/state",
    "deploy:worker": "wrangler deploy --cwd worker",
    "logs:worker": "wrangler tail --cwd worker",
    "test:workflow-trigger": "node --test tests/trigger-workflow-script.test.mjs",
    "test:workflow-security": "tsx --test tests/workflow-security.test.ts tests/workflow-efficiency.test.ts tests/audio-multipart.test.ts tests/reddit.test.ts tests/hackernews.test.ts tests/llm-fallback.test.ts tests/script-parser.test.ts tests/tts-fallback.test.ts tests/decision.test.ts",
    "test:web-cache": "tsx --test tests/web-cache-policy.test.ts tests/playback-share.test.ts tests/llms-txt.test.ts tests/transcript.test.ts",
    "test:webmcp": "tsx --test tests/webmcp.test.ts tests/mcp.test.ts",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test:build-gate": "node --test tests/build-gate.test.mjs tests/normalize-generated-types.test.mjs",
    "test:sources": "node tests/test-new-sources.mjs",
    "opennext": "opennextjs-cloudflare build",
    "preview": "npm run -s opennext && wrangler dev",
    "deploy": "npm run -s opennext && WRANGLER_BUILD_PLATFORM=node wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && node scripts/normalize-generated-types.mjs cloudflare-env.d.ts",
    "workflow:setup": "node scripts/setup-workflow-auth.mjs",
    "workflow:secret": "node --env-file=.env.workflow.local scripts/set-workflow-secret.mjs",
    "workflow:migrate-secrets": "node scripts/migrate-worker-vars-to-secrets.mjs",
    "workflow:run": "node --env-file=.env.workflow.local scripts/trigger-workflow.mjs --phase script",
    "workflow:audio": "node --env-file=.env.workflow.local scripts/trigger-workflow.mjs --phase audio --force",
    "test:workflow": "pnpm test:workflow-security && pnpm test:workflow-trigger",
    "social:post": "node scripts/social-post.mjs",
    "social:dry-run": "node scripts/social-post.mjs --dry-run",
    "social:login": "node scripts/social-post.mjs --login"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@echristian/edge-tts": "^0.0.14",
    "@modelcontextprotocol/server": "^2.4.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "ai": "^7.0.173",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "markdown-it": "^15.0.3",
    "next": "^16.4.6",
    "podcast": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.163.0"
  }
}
