{
  "name": "daily-podcast",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:workflow && pnpm test:web-cache && pnpm test:pwa && pnpm test:build-gate",
    "postinstall": "npm run -s cf-typegen",
    "dev:worker": "wrangler dev --cwd worker --persist-to ../.wrangler/state",
    "deploy:worker": "wrangler deploy --cwd worker",
    "logs:worker": "wrangler tail --cwd worker",
    "test:workflow-trigger": "node --test tests/trigger-workflow-script.test.mjs",
    "test:workflow-security": "tsx --test tests/workflow-security.test.ts tests/workflow-efficiency.test.ts tests/audio-multipart.test.ts",
    "test:web-cache": "tsx --test tests/web-cache-policy.test.ts",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test:build-gate": "node --test tests/build-gate.test.mjs tests/normalize-generated-types.test.mjs",
    "tests": "wrangler dev --cwd tests --remote",
    "test:sources": "node tests/test-new-sources.mjs",
    "opennext": "opennextjs-cloudflare build",
    "preview": "npm run -s opennext && wrangler dev",
    "deploy": "npm run -s opennext && WRANGLER_BUILD_PLATFORM=node wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && node scripts/normalize-generated-types.mjs cloudflare-env.d.ts",
    "workflow:setup": "node scripts/setup-workflow-auth.mjs",
    "workflow:secret": "node --env-file=.env.workflow.local scripts/set-workflow-secret.mjs",
    "workflow:migrate-secrets": "node scripts/migrate-worker-vars-to-secrets.mjs",
    "workflow:run": "node --env-file=.env.workflow.local scripts/trigger-workflow.mjs --phase script",
    "workflow:audio": "node --env-file=.env.workflow.local scripts/trigger-workflow.mjs --phase audio --force",
    "test:workflow": "pnpm test:workflow-security && pnpm test:workflow-trigger"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@cloudflare/puppeteer": "^1.1.0",
    "@echristian/edge-tts": "^0.0.14",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@shadcn/ui": "^0.0.4",
    "ai": "^4.3.19",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "markdown-it": "^14.3.0",
    "next": "^15.5.20",
    "player.style": "^0.1.10",
    "podcast": "^2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@ast-grep/napi-darwin-arm64": "^0.39.9",
    "@ast-grep/napi-linux-x64-gnu": "^0.39.9",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "eslint-plugin-format": "^1.5.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.20",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.112.0"
  }
}
