/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# 音訊檔案支援 byte-range requests（串流支援）
/*.mp3
  Accept-Ranges: bytes
  Cache-Control: public,max-age=31536000,immutable
  Content-Type: audio/mpeg

# Podcast 封面圖片
/*.png
  Accept-Ranges: bytes
  Cache-Control: public,max-age=86400
  Content-Type: image/png
