/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * API_SECRET_TOKEN is intentionally not stored in this file. After running
 * pnpm workflow:setup, configure it with:
 * pnpm workflow:secret
 */
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "daily-podcast-worker",
  "main": "./index.ts",
  "compatibility_date": "2025-04-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "assets": {
    "directory": "./static"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "30 0 * * *"
    ]
  },
  "keep_vars": false,
  "vars": {
    // --- TTS Configuration (Gemini is default) ---
    "TTS_PROVIDER": "gemini", // Options: gemini, openai, minimax, edge
    "GEMINI_TTS_MODEL": "gemini-2.5-flash-preview-tts",
    // Store GEMINI_TTS_API_SECRET with `wrangler secret put --cwd worker GEMINI_TTS_API_SECRET`.

    // --- Other Services ---
    "HACKER_NEWS_WORKER_URL": "https://podcast.yourdomain.com",
    // Store LLM_PRIMARY_API_KEY with `wrangler secret put --cwd worker LLM_PRIMARY_API_KEY`.
    "LLM_PRIMARY_BASE_URL": "https://api.openai.com/v1", // or Gemini proxy
    "OPENAI_MAX_COMPLETION_TOKENS": "1000000",
    "OPENAI_MAX_TOKENS": "1000000",
    "LLM_PRIMARY_MODEL": "gpt-4o",
    "LLM_PRIMARY_THINKING_MODEL": "gpt-4o",

    // Optional LLM fallbacks. Store each API secret with Wrangler, for example:
    // pnpm exec wrangler secret put --cwd worker LLM_FALLBACK_1_API_KEY
    // Slots 1-10 are supported. Endpoint/model values inherit from primary when omitted.
    "LLM_FALLBACK_1_BASE_URL": "https://api.openai.com/v1",
    "LLM_FALLBACK_1_MODEL": "gpt-4o-mini",
    "LLM_FALLBACK_1_THINKING_MODEL": "gpt-4o-mini",

    // OpenAI TTS Settings
    // Store OPENAI_TTS_API_SECRET with `wrangler secret put --cwd worker OPENAI_TTS_API_SECRET`.
    "OPENAI_TTS_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_TTS_INSTRUCTIONS": "請使用自然親切和活潑愉快的語氣。",
    "OPENAI_TTS_MODEL": "gpt-4o-mini-tts",

    "WORKER_ENV": "production",

    // --- Common Audio Settings ---
    "AUDIO_SPEED": "1.3" // 1.0 = normal, 1.3 = faster

    // --- Voice Customization (Optional Overrides) ---
    // "MAN_VOICE_ID": "Fenrir", // Gemini: Fenrir, OpenAI: onyx, Edge: zh-TW-YunJheNeural
    // "WOMAN_VOICE_ID": "Leda"  // Gemini: Leda, OpenAI: nova, Edge: zh-TW-HsiaoChenNeural
  },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "daily-podcast-workflow",
      "binding": "HACKER_NEWS_WORKFLOW",
      "class_name": "PodcastScriptWorkflow"
    },
    {
      "name": "daily-podcast-audio-workflow",
      "binding": "HACKER_NEWS_AUDIO_WORKFLOW",
      "class_name": "PodcastAudioWorkflow"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HACKER_NEWS_KV",
      "id": "eb092f9e71ec4c09afa31ffacf9beb40"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HACKER_NEWS_R2",
      "bucket_name": "hacker-news"
    }
  ]
}
