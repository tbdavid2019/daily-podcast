# Worker environment variables (sample)
# Copy this file to worker/.env.production and replace placeholder values.
# Secrets should still be set in Cloudflare via `pnpx wrangler secret put --cwd worker <KEY>`.

# Content extraction services
JINA_KEY="jina_xxx"                 # Secret
FIRECRAWL_KEY="fc_xxx"             # Secret

# Storage / URLs
HACKER_NEWS_R2_BUCKET_URL="https://your-bucket.r2.dev"  # Secret
HACKER_NEWS_WORKER_URL="https://your-worker.workers.dev" # Plaintext

# LLM settings (API_KEY is stored as a Cloudflare Secret)
LLM_PRIMARY_API_KEY="sk-xxx"      # Secret
LLM_PRIMARY_BASE_URL="https://api.openai.com/v1"
LLM_PRIMARY_MODEL="gpt-4o-mini"
LLM_PRIMARY_THINKING_MODEL="gpt-4o-mini-virtual"
OPENAI_MAX_TOKENS="4096"
OPENAI_MAX_COMPLETION_TOKENS="4096"

# Optional LLM fallbacks. Set the API_KEY values as Cloudflare Secrets.
# Slots 1-10 are supported; each slot can override the endpoint and models.
# LLM_FALLBACK_1_API_KEY="sk-fallback-xxx" # Secret
# LLM_FALLBACK_1_BASE_URL="https://backup.example/v1"
# LLM_FALLBACK_1_MODEL="backup-model"
# LLM_FALLBACK_1_THINKING_MODEL="backup-thinking-model"

# TTS settings
OPENAI_TTS_API_KEY="sk-tts-xxx"    # Secret
OPENAI_TTS_BASE_URL="https://api.openai.com/v1"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_INSTRUCTIONS="請使用自然親切的語氣。"
TTS_PROVIDER="openai"

# Misc
WORKER_ENV="production"
