# Worker environment variables (sample)
# Copy this file to worker/.env.production and replace placeholder values.
# Secrets should still be set in Cloudflare via `pnpx wrangler secret put --cwd worker <KEY>`.

# Content extraction services
JINA_KEY="jina_xxx"                 # Secret
FIRECRAWL_KEY="fc_xxx"             # Secret

# Storage / URLs
HACKER_NEWS_R2_BUCKET_URL="https://your-bucket.r2.dev"  # Secret
HACKER_NEWS_WORKER_URL="https://your-worker.workers.dev" # Plaintext

# OpenAI / model configs
OPENAI_API_KEY="sk-xxx"            # Secret
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_THINKING_MODEL="gpt-4o-mini-virtual"
OPENAI_MAX_TOKENS="4096"
OPENAI_MAX_COMPLETION_TOKENS="4096"

# TTS settings
OPENAI_TTS_API_KEY="sk-tts-xxx"    # Secret
OPENAI_TTS_BASE_URL="https://api.openai.com/v1"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_INSTRUCTIONS="請使用自然親切的語氣。"
TTS_PROVIDER="openai"

# Misc
WORKER_ENV="production"
